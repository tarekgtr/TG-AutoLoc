# Copy to .env on the VM (chmod 600). Never commit the real .env file.

# Public host name of the site, without https:// (e.g. tgautoloc.francecentral.cloudapp.azure.com or www.example.dz).
DOMAIN=

# Azure Database for PostgreSQL – flexible server.
DB_HOST=your-server.postgres.database.azure.com
DB_NAME=tgautoloc
DB_USERNAME=
DB_PASSWORD=

# Initial administrator: created at first start ONLY if none exists. At least 12 characters.
# Remove both values (and run `docker compose up -d` again) once you have logged in.
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=
