# Copy to .env.local for local development (never commit real .env files).

# URL the Next.js server uses to reach Spring Boot (server-side rendering and the /api proxy).
# Read at build time for the /api rewrite and at runtime for server-side fetches.
BACKEND_INTERNAL_URL=http://localhost:8080

# Public URL of the website: used for canonical URLs, Open Graph, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
