<?xml version="1.0" encoding="UTF-8"?>
<!--
  Project-scoped Maven settings: resolve dependencies from Maven Central.
  Overrides any global mirror (e.g. a corporate Nexus) for this project only.
  Remove .mvn/maven.config if you prefer your global ~/.m2/settings.xml.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
    <mirrors>
        <mirror>
            <id>central-mirror</id>
            <mirrorOf>*</mirrorOf>
            <url>https://repo.maven.apache.org/maven2</url>
        </mirror>
    </mirrors>
</settings>
