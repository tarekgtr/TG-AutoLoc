# Copy to .env and adjust. Never commit the real .env file.

# --- PostgreSQL -------------------------------------------------------------
DB_NAME=tgautoloc
DB_USERNAME=tgautoloc
# Required. Use a long random value (e.g. `openssl rand -base64 24`).
DB_PASSWORD=change-me-to-a-long-random-password
DB_PORT=5432

# --- Backend -----------------------------------------------------------------
# dev  = sample vehicles + Swagger UI enabled
# prod = no sample data, Swagger off, Secure cookies
SPRING_PROFILES_ACTIVE=dev
BACKEND_PORT=8080
# true when the site is served over HTTPS (required in production).
COOKIE_SECURE=false
API_DOCS_ENABLED=true

# Initial administrator: created at startup ONLY if no administrator exists yet.
# Password: at least 12 characters. Remove both values once the account exists.
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=

# --- Frontend ----------------------------------------------------------------
FRONTEND_PORT=3000
# Public URL of the website (canonical URLs, Open Graph, sitemap.xml).
SITE_URL=http://localhost:3000
